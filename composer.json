{
    "name": "schachbulle/contao-championslists-bundle",
    "type": "contao-bundle",
    "description": "Verwaltung von Siegerlisten von Schachturnieren für Contao 4.13 und Contao 5",
    "keywords": [
        "contao",
        "schach",
        "meisterliste",
        "championslists"
    ],
    "homepage": "https://github.com/Samson1964/contao-championslists-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Binding",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.0",
        "menatwork/contao-multicolumnwizard-bundle": "^3.5",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.3.1",
        "phpunit/phpunit": "^9.5"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "suggest": {
        "schachbulle/contao-spielerregister-bundle": "Verknüpft die Meister mit dem DSB-Spielerregister"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "contao/manager-plugin": true
        }
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoChampionslistsBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoChampionslistsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoChampionslistsBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-championslists-bundle/issues",
        "source": "https://github.com/Samson1964/contao-championslists-bundle"
    }
}
